{
  "version": 1,
  "hostname": "web-01",
  "mail": {
    "providers": [
      {
        "provider": "resend",
        "api_key": "",
        "from_address": "alerts@mail.example.com",
        "from_name": "Server Monitor"
      },
      {
        "provider": "smtp",
        "preset": "qq",
        "host": "smtp.qq.com",
        "port": 465,
        "tls": "ssl",
        "username": "you@example.com",
        "password": "",
        "from_address": "you@example.com"
      }
    ],
    "recipients": [
      "ops@example.com",
      "oncall@example.com"
    ],
    "login_recipients": [
      "ops@example.com"
    ],
    "from_address": "",
    "from_name": "Server Monitor",
    "reply_to": "",
    "language": "zh",
    "digest_min_items": 5,
    "digest_max_wait": 1800
  },
  "alerts": {
    "mode": "attacks",
    "renotify_seconds": 21600,
    "recovery_quiet_seconds": 600
  },
  "threat": {
    "enabled": true,
    "whitelist": [
      "127.0.0.1/8",
      "::1",
      "203.0.113.10/32"
    ],
    "notify_bans": true,
    "notify_ssh_success": true,
    "ssh": {
      "enabled": true,
      "max_failures": 5,
      "window_seconds": 300,
      "ban_seconds": [
        600,
        3600,
        21600,
        86400
      ]
    },
    "http": {
      "enabled": true,
      "max_attacks": 10,
      "window_seconds": 300,
      "ban_seconds": [
        600,
        3600,
        21600,
        86400
      ]
    },
    "recidivist_bans": 3,
    "autoresponse": {
      "enabled": false,
      "action": "stop",
      "observe_seconds": 120,
      "resume_window_seconds": 600,
      "after_observe": "hold",
      "terminate_signal": "SIGTERM",
      "max_per_hour": 2,
      "allowlist": [],
      "evidence_dir": ""
    }
  },
  "bouncer": {
    "enabled": false,
    "sync_seconds": 60
  },
  "evolve": {
    "enabled": false,
    "allow_code_edits": false,
    "source_root": "",
    "run_tests": true,
    "test_target": "",
    "max_code_edits_per_day": 3,
    "max_patch_lines": 40,
    "max_adopted": 200,
    "max_per_run": 5,
    "min_hits": 8,
    "min_ips": 3,
    "memory_pct": 5.0,
    "memory_floor_mb": 96,
    "load_ratio": 0.7,
    "time_budget": 120,
    "report_enabled": true,
    "report_url": ""
  },
  "checks": {
    "enabled": true,
    "memory": {
      "warn_available_pct": 20,
      "crit_available_pct": 10,
      "warn_available_mb": 0,
      "crit_available_mb": 0
    },
    "disk": {
      "warn_pct": 80,
      "crit_pct": 90,
      "paths": [
        "/"
      ]
    },
    "services": [
      "nginx",
      "sshd"
    ],
    "ports": [
      {
        "port": 22,
        "proto": "tcp"
      }
    ],
    "web_roots": [
      "/www/wwwroot"
    ],
    "backup": {
      "warn_hours": 36,
      "crit_hours": 72,
      "globs": [
        "/root/backup/*.tar.gz"
      ]
    },
    "certificates": {
      "warn_days": 21,
      "crit_days": 7,
      "dirs": [
        "/www/server/panel/vhost/cert"
      ]
    },
    "process_anomaly": {
      "cpu_warn": 80,
      "count_warn": 600,
      "whitelist": [],
      "build_dirs": []
    },
    "site_availability": {
      "domain": "",
      "port": 443,
      "warn_5xx_pct": 5,
      "crit_5xx_pct": 20,
      "log_lines": 200
    },
    "self_integrity": {
      "paths": [],
      "auto_recover": true,
      "heal_window_seconds": 1800,
      "heal_max_attempts": 3,
      "attribution_window_seconds": 86400,
      "deploy_window_seconds": 900
    }
  },
  "gate": {
    "bt_panel": {
      "enabled": true,
      "state_dir": "/www/server/bt-gate",
      "webroot": "/www/wwwroot/bt-gate",
      "entry_path": "/__btgate",
      "cookie": "btgate",
      "nav_cookie": "btnav",
      "scene_kind": "auto",
      "image_dirs": [
        "/var/lib/vigil-pictures"
      ]
    },
    "dsh_gate": {
      "enabled": true,
      "state_dir": "/www/server/dsh-gate",
      "webroot": "/www/wwwroot/dsh-gate",
      "entry_path": "/__gate/login",
      "cookie": "dshgate",
      "nav_cookie": "dshnav",
      "strict_nav": 1,
      "scene_kind": "auto",
      "image_dirs": [
        "/var/lib/vigil-pictures"
      ]
    },
    "login_alerts": true
  },
  "auditd": {
    "enabled": true,
    "key": "vigil_watch",
    "immutable": true
  },
  "loadshed": {
    "enabled": true,
    "protect_load": 6.0,
    "protect_conn": 800
  }
}
