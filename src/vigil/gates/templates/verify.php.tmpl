<?php
/**
 * Vigil gate — human verification page (and optionally sign-in).
 *
 * One template serves both gate types: `bt_panel` renders the challenge
 * alone, `login` adds a username and password.
 *
 * The challenge is a **jigsaw slider fused with a passcode**.
 *
 * OCR alone loses to the slider, and image analysis alone loses to the
 * passcode -- the two ask for different kinds of work, and both answers are
 * checked on the server against a single one-time challenge. A text-only
 * challenge remains available as the no-JavaScript fallback.
 *
 * Anti-automation layers, all verified server-side:
 *   · neither the offset nor the passcode is ever sent to the browser;
 *   · the failure message does not say which of the two was wrong, so the
 *     two cannot be searched independently;
 *   · the puzzle is cut from a randomly generated background, so there is
 *     nothing to pre-compute;
 *   · the drag trajectory must be sampled, variable-speed and forward-only,
 *     which rejects "set the value and submit" scripts even when they guess
 *     the offset correctly;
 *   · a hidden honeypot field catches form scrapers;
 *   · a minimum solve time is enforced against the challenge's own
 *     creation timestamp, so it cannot be bypassed by editing the form;
 *   · the challenge is consumed before comparison, so replay is impossible;
 *   · tolerance tightens as failures accumulate.
 */
declare(strict_types=1);

$cfg = require '__CONFIG_PATH__';
$policy = vigil_policy($cfg['policy']);

$stateDir  = rtrim($cfg['state_dir'], '/');
$entryPath = (string)$cfg['entry_path'];
$needPass  = !empty($cfg['require_password']);
$lang      = (string)($cfg['lang'] ?? 'zh');
vigil_state_dirs($stateDir);

$t = static function (string $zh, string $en) use ($lang): string {
    return $lang === 'en' ? $en : $zh;
};

$next = vigil_safe_next((string)($_REQUEST['next'] ?? '/'), rtrim($entryPath, '/'));
$error = '';
$status = 200;
$useSlider = (($_REQUEST['fallback'] ?? '') !== 'text');

// ---------------------------------------------------------------- submit
if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
    $honeypot = trim((string)($_POST['website'] ?? ''));
    $lockedFor = vigil_locked_for($stateDir);

    if ($lockedFor > 0) {
        vigil_audit($stateDir, 'LOCKED', 'remaining=' . $lockedFor);
        $error = sprintf($t('尝试次数过多，请在 %d 分钟后重试。',
                            'Too many attempts. Try again in %d minutes.'),
                         (int)ceil($lockedFor / 60));
        $status = 429;
    } else {
        $mode = (string)($_POST['mode'] ?? 'slider');
        if ($mode === 'slider') {
            $check = vigil_check_slider(
                $stateDir, $policy,
                (string)($_POST['cid'] ?? ''),
                (string)($_POST['drops'] ?? ''),
                $honeypot !== '',
                (string)($_POST['q_answer'] ?? ''));
        } else {
            $useSlider = false;
            $check = vigil_check_captcha(
                $stateDir, $policy,
                (string)($_POST['cid'] ?? ''),
                (string)($_POST['cap'] ?? ''),
                $honeypot !== '');
        }

        $ok = (bool)$check['ok'];
        $reason = (string)$check['reason'];

        if ($ok && $needPass) {
            $user = (string)($_POST['u'] ?? '');
            $pass = (string)($_POST['p'] ?? '');
            $userOk = hash_equals((string)$cfg['user'], $user);
            if ($userOk) {
                $passOk = password_verify($pass, (string)$cfg['pass_hash']);
            } else {
                // Burn equivalent time so the response cannot reveal
                // whether the account exists.
                vigil_dummy_verify($pass);
                $passOk = false;
            }
            if (!$userOk || !$passOk) {
                $ok = false;
                $reason = 'BAD_CRED';
                usleep(500000);
            }
        }

        if ($ok) {
            vigil_fail_clear($stateDir);
            vigil_prune($stateDir, $policy);
            $bindUa = ((int)$policy['bind_ua']) >= 1
                ? (string)($_SERVER['HTTP_USER_AGENT'] ?? '') : '';
            $bindIp = ((int)$policy['bind_ip']) >= 1 ? vigil_client_ip() : '';
            $tok = vigil_issue_ticket($stateDir, (int)$policy['session_ttl'],
                                      $bindUa, $bindIp);
            setcookie((string)$cfg['cookie'], $tok,
                      vigil_cookie_options((int)($cfg['cookie_lifetime'] ?? 0)));
            if (!empty($cfg['nav_cookie'])) {
                $nav = vigil_issue_ticket($stateDir, (int)$policy['nav_ttl'],
                                          $bindUa, $bindIp);
                setcookie((string)$cfg['nav_cookie'], $nav,
                          vigil_cookie_options(0));
            }
            if (is_callable($cfg['on_success'] ?? null)) {
                ($cfg['on_success'])($cfg);
            }
            vigil_audit($stateDir, 'OK', 'mode=' . $mode . ' next=' . $next);
            header('Cache-Control: no-store');
            header('Location: ' . $next, true, 302);
            exit;
        }

        // The two failure kinds are counted separately: see vigil_fail_bump.
        vigil_fail_bump($stateDir, $policy,
                        $reason === 'BAD_CRED' ? 'BAD_CRED' : 'CHALLENGE');
        vigil_audit($stateDir, 'FAIL', 'mode=' . $mode . ' reason=' . $reason);
        $remaining = vigil_locked_for($stateDir);
        if ($remaining > 0) {
            $error = sprintf($t('尝试次数过多，请在 %d 分钟后重试。',
                                'Too many attempts. Try again in %d minutes.'),
                             (int)ceil($remaining / 60));
            $status = 429;
        } else {
            // Deliberately does not say *which* factor failed. Telling a
            // script "the position was right, the code was wrong" hands it a
            // free oracle to search the two independently; a person only
            // needs to know both must be right.
            // No count in this message on purpose: on the submit path the
            // challenge has already been consumed, so the real number is not
            // available here -- and a number that can disagree with the page
            // is worse than no number. "每一块" is always true.
            // Mode-specific, because telling somebody who mistyped a text
            // code to "check that the two pieces are in their gaps" is an
            // error message about a screen they are not looking at.
            //
            // It still does not say *which* factor failed within a mode:
            // inside the puzzle, "position" and "question" stay merged so they
            // cannot be searched independently.
            if ($mode === 'slider') {
                $error = $t('验证未通过：请确认拖出的两块拼片都对准了缺口（另有一块需留在原处），且问题回答正确。',
                            'Not verified: check the two moved pieces are in their gaps (exactly one must be left alone) and that the question is answered.');
            } else {
                $error = $t('验证码不正确，请重新输入图中的字符。',
                            'That code was not correct. Please type the characters in the picture again.');
            }
            $status = 401;
        }
    }
    if ($status !== 200) {
        http_response_code($status);
    }
}

// ---------------------------------------------------------------- render
vigil_prune($stateDir, $policy);

$nonce = base64_encode(random_bytes(16));
vigil_send_security_headers($useSlider ? $nonce : '');

if (!vigil_can_issue($stateDir, $policy)) {
    http_response_code(429);
    $wait = $t('请求过于频繁，请稍后再试。', 'Too many requests, please slow down.');
    echo '<!DOCTYPE html><html lang="' . htmlspecialchars($lang, ENT_QUOTES)
       . '"><meta charset="utf-8"><body style="font:15px/1.6 system-ui,sans-serif;padding:2rem">'
       . '<p>' . htmlspecialchars($wait, ENT_QUOTES) . '</p></body></html>';
    exit;
}

$slider = null;
$chal = null;
if ($useSlider) {
    $slider = vigil_new_slider($stateDir, $policy, $cfg);
    if (empty($slider['ok'])) {
        // GD missing or the puzzle could not be built: fall back rather
        // than show a person a broken page.
        $useSlider = false;
        $chal = vigil_new_captcha($stateDir, $policy);
    }
} else {
    $chal = vigil_new_captcha($stateDir, $policy);
}

$e = static fn(string $s): string => htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
$bgW = $useSlider ? (int)$slider['width'] : 220;
?>
