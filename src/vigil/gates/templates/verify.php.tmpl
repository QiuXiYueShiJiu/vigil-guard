      <!-- No script needed: if the picture never appears, this still works. -->
      <a href="<?= $e($entryPath) ?>?fallback=text&amp;next=<?= $e(rawurlencode($next)) ?>"
         style="color:#8a94a6"><?= $e($t('文字验证码', 'text challenge')) ?></a>
    </div>
  <?php else: ?>
    <label for="cap"><?= $e($t('验证码', 'Verification code')) ?></label>
    <div class="row">
      <input id="cap" type="text" name="cap" required
             maxlength="<?= (int)$policy['captcha_length'] + 3 ?>"
             autocapitalize="characters" autocorrect="off" spellcheck="false"
             autocomplete="off" inputmode="latin" placeholder="······">
      <?php
      // Drawn here and carried in the page. The text challenge is the escape
      // hatch, so it must not depend on a second request succeeding: if the
      // picture has to be fetched, the fallback can fail in exactly the way
      // it exists to survive.
      $capSrc = (string)$cfg['captcha'] . '?cid=' . $chal['id'];
      if (!empty($cfg['inline_images'])) {
          $capPng = vigil_captcha_png((string)$chal['code'], (int)($chal['weight'] ?? 0));
          if ($capPng !== '') {
              $capSrc = 'data:image/png;base64,' . base64_encode($capPng);
          }
      }
      ?>
      <div class="cap" style="position:relative">
        <img src="<?= $e($capSrc) ?>"
             width="<?= 40 + (int)$chal['length'] * 30 ?>" height="74" alt="">
        <a href="<?= $e($entryPath) ?>?next=<?= $e(rawurlencode($next)) ?>"></a>
      </div>
    </div>
  <?php endif; ?>

  <?php if ($error !== ''): ?>
    <div class="err" role="alert"><?= $e($error) ?></div>
  <?php endif; ?>

  <button type="submit" id="go"><?= $e($t('进入', 'Continue')) ?></button>
  <div class="tip"><?= $e($t('本页面用于确认访问者为真人，请勿分享链接。',
                              'This step confirms you are a person. Do not share the link.')) ?></div>
</form>

<?php if ($useSlider): ?>
<script nonce="<?= $e($nonce) ?>">
/* Slider puzzle.
 *
 * The picture is shown whole and still. The piece is dragged into the marked
 * gap, and the characters printed across the top of the picture are typed
 * into the field below. Both are checked by the server; neither answer is
 * present on this page.
 *
 * The picture used to be scrambled into drifting bands that knitted back
 * together as the piece approached the gap. That settle was the guidance --
 * and it required the page to know where the gap was, which meant serving an
 * unmarked copy of the background so the two could be differenced. Two PNGs
 * differing only by the gap marker hand the answer to anyone who subtracts
 * them. Any "you are close" feedback is also a hint a bot can read, so the
 * animation went and the alignment became exact instead.
 *
 * Two kinds of picture, animated differently on purpose:
 *
 *   art   -- generated Q-style landscape. It is a place, so it gets weather:
 *            drifting cloud shadow, turning sun rays, a flock, butterflies,
 *            swaying grass, motes. Everything here is drawn, so nothing
 *            clashes.
 *   image -- a photograph or an illustration from the host's own pool. It
 *            gets a *focus pull* instead: blurred and desaturated while the
 *            picture is broken, sharpening to full colour as it comes
 *            together. Cartoon birds over someone's artwork would be
 *            vandalism, and the focus pull reads as the same promise --
 *            chaos resolving into clarity -- without touching the art.
 *
 * Everything animates through requestAnimationFrame towards a target rather
 * than being set directly, so no input can produce a jump. Plain DOM APIs,
 * no dependencies, nonce'd for the strict CSP.
 */
(function () {
  "use strict";
  var host  = document.getElementById("puzzle");
  var cv    = document.getElementById("cv");
  var hint  = document.getElementById("distance");
  var form  = document.getElementById("f");
  var go    = document.getElementById("go");
  // One slider per piece. Each drives its own slot, so the two drags cannot
  // be confused with each other and each gets its own recorded track.
  // One hidden field trio per piece: where it was dropped, and the path it
  // took to get there. There is no slider any more -- the piece is dragged
  // freely, so the path is two-dimensional and carries far more than a
  // single number ever could.
  var fDrops = document.getElementById("drops");
  if (!host || !cv) { return; }
  var fallbackUrl = host.dataset.fallback;

  /* ---------------- if this ever breaks, say so ----------------
   *
   * The script once died on its first statement that mentioned a variable a
   * refactor had deleted. The visitor got an empty box: no picture, no
   * message, nothing in the access log, and no way to tell a broken page from
   * a slow one. A failed challenge must be *legibly* failed.
   *
   * An uncaught error anywhere in this script -- including inside a drag
   * handler, where a try/catch around the setup would never see it -- lands
   * here. The message is shown truncated: it is a diagnostic, not a stack
   * trace, and on an inline script it can only name our own variables.
   */
  var fail = document.getElementById("jsfail");
  var failWhy = document.getElementById("jsfail-why");
  var escaped = false;
  function showFail(why) {
    if (!fail) { return; }
    if (failWhy && why) { failWhy.textContent = String(why).slice(0, 140); }
    fail.style.display = "block";
  }
  /* If the puzzle cannot be drawn, the visitor must still be able to get in.
   *
   * The message is shown first and the page then moves itself to the text
   * challenge, which is drawn server-side into the page and needs no script
   * at all. Being stuck behind a blank box is not an acceptable outcome for a
   * login gate, and "we logged it for the operator" is no help to the person
   * standing at the door. Three seconds is enough to read one line.
   */
  function escapeToText(why) {
    showFail(why);
    if (escaped) { return; }
    escaped = true;
    setTimeout(function () {
      window.location.replace(fallbackUrl);
    }, 3000);
  }
  window.addEventListener("error", function (ev) {
    escapeToText(ev && ev.message ? ev.message : "");
  }, false);

  var W = parseInt(host.dataset.w, 10) || 340;
  var H = parseInt(host.dataset.h, 10) || 200;
  var PW = parseInt(host.dataset.pw, 10) || 55;
  var PH = parseInt(host.dataset.ph, 10) || 64;
  var MAX = parseInt(host.dataset.max, 10) || (W - PW);
  var MAXY = Math.max(0, H - PH);
  var glow = (host.dataset.glow || "120,200,255").split(",").map(Number);
  var sunRaw = host.dataset.sun || "";
  var sun = sunRaw ? sunRaw.split(",").map(Number) : null;
  var ART = (host.dataset.kind || "art") !== "image";

  /* ---------------- ask for the pictures first ----------------
   *
   * Every image is requested here, before a single canvas is created and
   * before the animation loop exists. Decoding a photograph is the slowest
   * thing this page does, and it must not be gated behind work that can
   * throw: when it was, one bad statement above meant the browser never asked
   * for anything at all and the page sat empty.
   *
   * `pieces` is a JSON list of {y, u} handed over by the server: the y each
   * piece belongs at, and where to fetch it. It deliberately carries no x --
   * that is the answer.
   */
  var pieces = [];
  try { pieces = JSON.parse(host.dataset.pieces || "[]") || []; }
  catch (e) { pieces = []; }
  if (!pieces.length) { pieces = [{ y: 0, u: host.dataset.piece }]; }

  var wanted = [host.dataset.bg || "", host.dataset.objects || ""], wi;
  for (wi = 0; wi < pieces.length; wi++) { wanted.push(pieces[wi].u || ""); }
  var pre = [];
  for (wi = 0; wi < wanted.length; wi++) {
    // No crossOrigin: the pictures are same-origin and the canvas is never
    // read back, so asking for CORS would only add a new way to fail.
    var pim = new Image();
    pim.src = wanted[wi];
    pre.push(pim);
  }
  var PRE_BG = 0, PRE_OBJ = 1, PRE_PIECE = 2;

  cv.width = W; cv.height = H;
  var ctx = cv.getContext("2d");
  // Canvas filters are the cheap way to do the focus pull, but they are not
  // universal; the puzzle must not depend on them to be solvable.
  var canFilter = (typeof ctx.filter === "string");

  var bgCanvas = document.createElement("canvas");
  bgCanvas.width = W; bgCanvas.height = H;
  var bgCtx = bgCanvas.getContext("2d", { willReadFrequently: true });
  var tops = [];
  var pieceCanvas = [], pieceCtx = [];
  for (var pi = 0; pi < pieces.length; pi++) {
    tops.push(parseInt(pieces[pi].y, 10) || 0);
    var pc = document.createElement("canvas");
    pc.width = PW; pc.height = PH;
    pieceCanvas.push(pc);
    pieceCtx.push(pc.getContext("2d", { willReadFrequently: true }));
  }
  // Bands are composed here first, so the warp and the focus pull are applied
  // once to a finished frame instead of to each band separately.
  var stage = document.createElement("canvas");
  stage.width = W; stage.height = H;
  var stageCtx = stage.getContext("2d");
  // The question shapes, on their own layer. Drawn *after* the pieces so a
  // piece dragged over one cannot hide it -- a hidden shape would make the
  // count question unanswerable, which is a defect rather than difficulty.
  var objCanvas = document.createElement("canvas");
  objCanvas.width = W; objCanvas.height = H;
  var objCtx = objCanvas.getContext("2d", { willReadFrequently: true });

  // Matches vigil_slider_in_tray() on the server. Generous because "drag the
  // extra piece back" is done with a thumb; safe because the generator keeps
  // every gap at least 48px away from its tray position.
  var TRAY_TOL = 10;
  var curs = [], dragging = false, active = 0, grabDX = 0, grabDY = 0;
  var trajs = [], t0 = 0;
  var tray = [];
  for (var ci = 0; ci < pieces.length; ci++) {
    // Start in a tray along the bottom, spread out. They are *not* started
    // at their gaps -- the piece has to be carried there, which is the whole
    // point of watching the path.
    var tx = Math.round((ci + 0.5) * (W / pieces.length) - PW / 2);
    var ty = Math.max(0, MAXY - ci * 5);
    curs.push({ x: Math.max(0, Math.min(MAX, tx)), y: ty });
    trajs.push([]);
    tray.push({ x: Math.max(0, Math.min(MAX, tx)), y: ty });
  }
  var shown = 0, target = 0;
  var boost = 0;              // decays; nudged by interaction for feedback

  function rnd(a, b) { return a + Math.random() * (b - a); }

  /* ---------------- the little ecosystem ----------------
   *
   * Counts are deliberately modest. This runs on every frame, on whatever
   * device is asking for the page -- including a phone on a train -- so the
   * scene has to feel alive without becoming the reason the page stutters.
   */
  var birds = [], bugs = [], motes = [], petals = [], ripples = [];
  var i;
  for (i = 0; i < 7; i++) {
    birds.push({ x: rnd(-30, W + 30), y: rnd(H * 0.05, H * 0.40),
                 s: rnd(2.0, 3.4), v: rnd(9, 22), ph: rnd(0, 6.28),
                 bob: rnd(3, 9) });
  }
  for (i = 0; i < 12; i++) {
    bugs.push({ x: rnd(0, W), y: rnd(H * 0.55, H * 0.96), s: rnd(1.5, 2.7),
                ph: rnd(0, 6.28), vx: rnd(-7, 7), vy: rnd(-3, 3),
                hue: i % 3 });
  }
  for (i = 0; i < 34; i++) {
    motes.push({ x: rnd(0, W), y: rnd(0, H), r: rnd(0.6, 1.7),
                 ph: rnd(0, 6.28), vy: rnd(-5, -1.2) });
  }
  for (i = 0; i < 14; i++) {
    petals.push({ x: rnd(0, W), y: rnd(-H, H), s: rnd(1.8, 3.6),
                  vy: rnd(5, 14), ph: rnd(0, 6.28) });
  }

  /* How far along the track the piece is, 0..1.
   *
   * This used to be "how close to the gap", which meant the page had to know
   * where the gap was -- and it worked that out by differencing the marked
   * background against an unmarked copy. That made the answer computable in
   * the browser: two PNGs differing only by the gap marker give the gap's
   * position to anyone who subtracts them, and a bot could lift the offset
   * straight out of the pixels.
   *
   * So the settle animation is now driven by the drag itself. It is
   * decoration and deliberately carries no correctness signal: it settles
   * wherever the piece happens to be, so reading it tells an attacker
   * nothing about whether the answer is right. Lining the picture up is done
   * by eye, against the gap that is visibly marked in the background. */
  function progressFor(px) {
    if (!(MAX > 0)) { return 0; }
    var p = px / MAX;
    if (p < 0) { p = 0; }
    if (p > 1) { p = 1; }
    return p;
  }

  // The picture is static, so there are no bands to compose: the frame is
  // the background. `stage` and `present` are kept because the ambient
  // effects composite through them, but the scramble machinery that used to
  // live here is gone with the animation it existed for.
  function compose(t, chaos) {
    stageCtx.clearRect(0, 0, W, H);
    stageCtx.drawImage(bgCanvas, 0, 0);
  }

  /* Present the composed frame.
   *
   * Art gets a travelling heat haze -- horizontal strips displaced
   * vertically, amplitude tied to how broken the picture still is -- which
   * is what makes the mid-drag state shimmer. An image gets the focus pull
   * instead, because haze over a photograph reads as a rendering fault. */
  function present(t, p, chaos) {
    ctx.clearRect(0, 0, W, H);
    if (ART) {
      if (chaos > 0.006) {
        var n = 22, hh = H / n;
        for (var s = 0; s < n; s++) {
          var sy = s * hh;
          var dy = chaos * (3.4 * Math.sin(sy / 8.5 + t * 0.0022)
                          + 1.5 * Math.sin(sy / 3.4 - t * 0.0034));
          var src = Math.max(0, sy - 2);
          ctx.drawImage(stage, 0, src, W, Math.min(H - src, hh + 4),
                        0, sy + dy, W, hh + 4);
        }
      } else {
        ctx.drawImage(stage, 0, 0);
      }
      return;
    }
    if (canFilter && chaos > 0.02) {
      ctx.save();
      ctx.filter = "blur(" + (chaos * 3.6).toFixed(2) + "px) saturate("
                 + (0.62 + 0.38 * p).toFixed(3) + ")";
      ctx.drawImage(stage, 0, 0);
      ctx.restore();
      ctx.filter = "none";
    } else {
      ctx.drawImage(stage, 0, 0);
    }
  }

  /* ---------------- ambient life ---------------- */

  function drawRays(t, a) {
    if (!sun) { return; }
    ctx.save();
    ctx.globalCompositeOperation = "lighter";
    ctx.translate(sun[0], sun[1]);
    ctx.rotate(t * 0.00006);
    var n = 10;
    for (var k = 0; k < n; k++) {
      var ang = (k / n) * Math.PI * 2;
      var len = H * (0.34 + 0.14 * Math.sin(t * 0.0009 + k));
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(Math.cos(ang - 0.045) * len, Math.sin(ang - 0.045) * len);
      ctx.lineTo(Math.cos(ang + 0.045) * len, Math.sin(ang + 0.045) * len);
      ctx.closePath();
      ctx.fillStyle = "rgba(" + glow.join(",") + "," + (0.045 * a).toFixed(3) + ")";
      ctx.fill();
    }
    ctx.restore();
  }

  function drawCloudShadow(t, a) {
    ctx.save();
    for (var k = 0; k < 3; k++) {
      var px = ((t * 0.0042 * (1 + k * 0.45) + k * 190) % (W + 220)) - 110;
      var py = H * (0.30 + k * 0.16);
      var rx = 96 + k * 30, ry = 26 + k * 8;
      var g = ctx.createRadialGradient(px, py, 0, px, py, rx);
      g.addColorStop(0, "rgba(24,32,58," + (0.085 * a).toFixed(3) + ")");
      g.addColorStop(1, "rgba(24,32,58,0)");
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.ellipse(px, py, rx, ry, 0, 0, 6.2832);
      ctx.fill();
    }
    ctx.restore();
  }

  function drawBirds(t, a, dt) {
    ctx.save();
    ctx.strokeStyle = "rgba(28,34,58," + (0.5 * a).toFixed(3) + ")";
    ctx.lineWidth = 1.4;
    ctx.lineCap = "round";
    for (var k = 0; k < birds.length; k++) {
      var b = birds[k];
      b.x += b.v * dt / 1000;
      if (b.x > W + 30) { b.x = -30; b.y = rnd(H * 0.05, H * 0.40); }
      var fl = Math.sin(t * 0.0075 + b.ph);
      var by = b.y + Math.sin(t * 0.0012 + b.ph) * b.bob;
      var sp = b.s * (0.55 + 0.45 * Math.abs(fl));
      ctx.beginPath();
      ctx.moveTo(b.x - sp, by + sp * 0.5 * fl);
      ctx.quadraticCurveTo(b.x - sp * 0.4, by - sp * 0.35, b.x, by);
      ctx.quadraticCurveTo(b.x + sp * 0.4, by - sp * 0.35, b.x + sp, by + sp * 0.5 * fl);
      ctx.stroke();
    }
    ctx.restore();
  }

  function drawBugs(t, a, dt) {
    ctx.save();
    for (var k = 0; k < bugs.length; k++) {
      var g = bugs[k];
      g.x += g.vx * dt / 1000;
      g.y += g.vy * dt / 1000;
      if (g.x < -6) { g.x = W + 6; }
      if (g.x > W + 6) { g.x = -6; }
      if (g.y < H * 0.5) { g.vy = Math.abs(g.vy); }
      if (g.y > H - 2) { g.vy = -Math.abs(g.vy); }
      g.vx += rnd(-9, 9) * dt / 1000;
      g.vy += rnd(-6, 6) * dt / 1000;
      g.vx = Math.max(-16, Math.min(16, g.vx));
      g.vy = Math.max(-9, Math.min(9, g.vy));
      var flap = 0.35 + 0.65 * Math.abs(Math.sin(t * 0.019 + g.ph));
      var by = g.y + Math.sin(t * 0.006 + g.ph) * 2.4;
      if (ART) {
        var cols = ["255,196,120", "255,150,190", "180,220,255"];
        ctx.fillStyle = "rgba(" + cols[g.hue] + "," + (0.72 * a).toFixed(3) + ")";
        ctx.beginPath();
        ctx.ellipse(g.x - g.s * 0.85, by, g.s * flap, g.s * 0.62, -0.4, 0, 6.2832);
        ctx.ellipse(g.x + g.s * 0.85, by, g.s * flap, g.s * 0.62, 0.4, 0, 6.2832);
        ctx.fill();
      } else {
        // On artwork the same swarm becomes bokeh, which flatters a picture
        // instead of drawing on top of it.
        var rg = ctx.createRadialGradient(g.x, by, 0, g.x, by, g.s * 5);
        rg.addColorStop(0, "rgba(255,244,214," + (0.30 * a).toFixed(3) + ")");
        rg.addColorStop(1, "rgba(255,244,214,0)");
        ctx.fillStyle = rg;
        ctx.beginPath();
        ctx.arc(g.x, by, g.s * 5, 0, 6.2832);
        ctx.fill();
      }
    }
    ctx.restore();
  }

  function drawMotes(t, a, dt) {
    ctx.save();
    for (var k = 0; k < motes.length; k++) {
      var m = motes[k];
      m.y += m.vy * dt / 1000;
      m.x += Math.sin(t * 0.0011 + m.ph) * 0.25;
      if (m.y < -4) { m.y = H + 4; m.x = rnd(0, W); }
      ctx.fillStyle = ART
        ? "rgba(255,255,255," + (0.42 * a).toFixed(3) + ")"
        : "rgba(255,250,235," + (0.30 * a).toFixed(3) + ")";
      ctx.beginPath();
      ctx.arc(m.x, m.y, m.r, 0, 6.2832);
      ctx.fill();
    }
    ctx.restore();
  }

  function drawPetals(t, a, dt) {
    ctx.save();
    for (var k = 0; k < petals.length; k++) {
      var p = petals[k];
      p.y += p.vy * dt / 1000;
      p.x += Math.sin(t * 0.0016 + p.ph) * 0.7;
      if (p.y > H + 6) { p.y = -6; p.x = rnd(0, W); }
      ctx.fillStyle = ART
        ? "rgba(255,190,215," + (0.72 * a).toFixed(3) + ")"
        : "rgba(255,238,246," + (0.40 * a).toFixed(3) + ")";
      ctx.beginPath();
      ctx.ellipse(p.x, p.y, p.s, p.s * 0.55, Math.sin(t * 0.002 + p.ph), 0, 6.2832);
      ctx.fill();
    }
    ctx.restore();
  }

  function drawGrassSway(t, a) {
    var base = H - 2;
    ctx.save();
    ctx.strokeStyle = "rgba(30,62,44," + (0.34 * a).toFixed(3) + ")";
    ctx.lineWidth = 1.1;
    ctx.lineCap = "round";
    for (var k = 0; k < 26; k++) {
      var x = (k + 0.5) * (W / 26) + Math.sin(k * 3.1) * 6;
      var hgt = 5 + (k % 5) * 2.2;
      var lean = Math.sin(t * 0.0022 + k * 0.7) * (2.4 + (k % 3));
      ctx.beginPath();
      ctx.moveTo(x, base);
      ctx.quadraticCurveTo(x + lean * 0.5, base - hgt * 0.6, x + lean, base - hgt);
      ctx.stroke();
    }
    ctx.restore();
  }

  function drawSweep(t, a) {
    var px = ((t * 0.022) % (W + 260)) - 130;
    ctx.save();
    ctx.globalCompositeOperation = "lighter";
    var g = ctx.createLinearGradient(px - 60, 0, px + 60, H);
    g.addColorStop(0, "rgba(255,255,255,0)");
    g.addColorStop(0.5, "rgba(255,255,255," + (0.085 * a).toFixed(3) + ")");
    g.addColorStop(1, "rgba(255,255,255,0)");
    ctx.fillStyle = g;
    ctx.fillRect(px - 70, 0, 140, H);
    ctx.restore();
  }

  function drawRipples(dt) {
    ctx.save();
    for (var k = ripples.length - 1; k >= 0; k--) {
      var r = ripples[k];
      r.r += dt * 0.16;
      r.life -= dt / 620;
      if (r.life <= 0) { ripples.splice(k, 1); continue; }
      ctx.strokeStyle = "rgba(" + glow.join(",") + ","
                      + (r.life * 0.5).toFixed(3) + ")";
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(r.x, r.y, r.r, 0, 6.2832);
      ctx.stroke();
    }
    ctx.restore();
  }

  function drawPiece(p, chaos, t) {
    // No highlight is drawn here any more. It was positioned at the gap's
    // exact x, so a screenshot of the canvas handed over the answer. The gap
    // is marked in the background image itself, which is what the solver
    // aims at -- drawing a second, precisely-placed marker on top of it only
    // made the answer easier to measure.
    for (var k = 0; k < pieceCanvas.length; k++) {
      ctx.save();
      ctx.shadowColor = "rgba(8,12,24," + (0.48 - 0.28 * p) + ")";
      ctx.shadowBlur = 11 - 8 * p;
      ctx.shadowOffsetY = 5 - 4 * p;
      ctx.drawImage(pieceCanvas[k], 0, 0, PW, PH,
                    curs[k].x, curs[k].y, PW, PH);
      ctx.restore();
    }

    // The frame does not change on success. A green ring the instant the
    // piece is close enough is a precise pass/fail signal, readable by
    // anything that can take a screenshot -- and the whole point of this
    // page is that the answer cannot be found without looking at the
    // picture. Success shows itself by the page moving on.
    host.style.boxShadow = "inset 0 0 0 1px rgba(255,255,255,.10),"
                         + " 0 6px 18px -8px rgba(16,23,40,.55)";
  }

  /* How many pieces are out of the tray right now.
   *
   * Used both for the reminder while dragging and for the check at submit
   * time. "Out of the tray" uses the same TRAY_TOL the server's
   * vigil_slider_in_tray() uses, so the two agree about what "placed" means.
   */
  function placedCount() {
    var n = 0;
    for (var k = 0; k < curs.length; k++) {
      if (Math.abs(curs[k].x - tray[k].x) > TRAY_TOL
          || Math.abs(curs[k].y - tray[k].y) > TRAY_TOL) {
        n++;
      }
    }
    return n;
  }

  /* Keep the tray outline for pieces that have been moved away, so "put it
   * back where it was" is a place to aim at rather than a guess. Drawn under
   * the pieces: it is a hint for a person, not a target marker. */
  function drawTrayHints() {
    var NEED = parseInt(host.dataset.need, 10) || 2;
    if (placedCount() <= NEED) { return; }
    ctx.save();
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = "rgba(255,255,255,0.55)";
    ctx.lineWidth = 1.2;
    for (var k = 0; k < tray.length; k++) {
      ctx.strokeRect(tray[k].x + 0.5, tray[k].y + 0.5, PW - 1, PH - 1);
    }
    ctx.restore();
  }

  function setPiece(slot, px, py) {
    var c = curs[slot];
    if (!c) { return; }
    c.x = Math.max(0, Math.min(MAX, Math.round(px)));
    if (py !== undefined && py !== null) {
      c.y = Math.max(0, Math.min(MAXY, Math.round(py)));
    }
    target = progressFor(c.x);
    // No proximity readout. "Very close" / "a bit closer" is a coarse oracle
    // but an oracle all the same: an attacker who can read it can walk the
    // slider towards the answer without interpreting the image at all. The
    // gap highlight and the picture reassembling are the feedback; both
    // require actually looking.
    if (hint) { hint.textContent = ""; }
  }

  var raf = null, lastTs = 0;
  function frame(ts) {
    var t = ts || 0;
    var dt = lastTs ? Math.min(48, t - lastTs) : 16;
    lastTs = t;

    var diff = target - shown;
    if (Math.abs(diff) > 0.0015) { shown += diff * 0.16; } else { shown = target; }
    // The picture is shown at rest -- bands undisplaced -- so that the gap
    // sits exactly where the background image has it, and the piece lines up
    // with it by direct correspondence.
    //
    // This used to be `1 - shown`, i.e. the bands knitted back together as
    // the piece approached the *answer*. That settle was the guidance, and
    // it required the page to know where the gap was -- which it worked out
    // by differencing the marked background against an unmarked copy, the
    // very thing that made the answer computable in the browser.
    //
    // There is no way to keep both: any feedback that tells the solver "you
    // are close" also tells a bot. So the animation goes and the alignment
    // becomes exact instead. What is left is the standard slide-to-fit
    // puzzle, and the strength comes from the server-side drag checks.
    var chaos = 0;
    if (boost > 0) {
      boost *= Math.exp(-dt / 420);
      if (boost < 0.005) { boost = 0; }
    }

    compose(t, chaos);
    present(t, shown, chaos);

    // Ambient intensity: never zero, so the picture is alive even when it is
    // whole, but noticeably calmer -- the scene settling is part of the
    // reward for solving it.
    var a = (0.42 + 0.58 * chaos) * (1 + boost * 0.9);
    if (a > 1.7) { a = 1.7; }

    if (ART) {
      drawRays(t, a);
      drawCloudShadow(t, a);
      drawGrassSway(t, a);
    } else {
      drawSweep(t, a);
    }
    drawBirds(t, a, dt);
    drawMotes(t, a, dt);
    drawPetals(t, a, dt);
    drawBugs(t, a, dt);

    drawTrayHints();
    drawPiece(shown, chaos, t);
    // Over the pieces, deliberately: see the note where objCanvas is made.
    ctx.drawImage(objCanvas, 0, 0);
    drawRipples(dt);

    raf = requestAnimationFrame(frame);
  }

  function cvt(clientX) {
    var r = cv.getBoundingClientRect();
    var scale = W / Math.max(1, r.width);
    return (clientX - r.left) * scale;
  }
  function point(e) {
    if (e.touches && e.touches.length) { return e.touches[0].clientX; }
    if (e.changedTouches && e.changedTouches.length) {
      return e.changedTouches[0].clientX;
    }
    return e.clientX;
  }
  function pointY(e) {
    if (e.touches && e.touches.length) { return e.touches[0].clientY; }
    if (e.changedTouches && e.changedTouches.length) {
      return e.changedTouches[0].clientY;
    }
    return e.clientY;
  }

  // Free dragging on the canvas.
  //
  // There is no slider any more. A slider produces a single number, so the
  // only thing that can be judged is *where* it ended up; the path is a
  // one-dimensional ramp that a script synthesises trivially. Dragging the
  // piece in two dimensions produces a path with curvature, hesitation,
  // overshoot and micro-correction -- all of which are recorded and all of
  // which a generator finds hard to fake convincingly. The position is also
  // two-dimensional now, so the answer space is squared.
  function localPoint(e) {
    var r = cv.getBoundingClientRect();
    var scaleX = W / Math.max(1, r.width);
    var scaleY = H / Math.max(1, r.height);
    return { x: (point(e) - r.left) * scaleX,
             y: (pointY(e) - r.top) * scaleY };
  }

  // Which piece did the pointer grab? Topmost first, and generously: a
  // person should not have to hit the exact pixels.
  function pieceAt(pt) {
    for (var k = curs.length - 1; k >= 0; k--) {
      var c = curs[k];
      if (pt.x >= c.x - 6 && pt.x <= c.x + PW + 6
          && pt.y >= c.y - 6 && pt.y <= c.y + PH + 6) {
        return k;
      }
    }
    return -1;
  }

  function grab(e) {
    var pt = localPoint(e);
    var k = pieceAt(pt);
    if (k < 0) { return; }
    active = k;
    dragging = true;
    grabDX = pt.x - curs[k].x;
    grabDY = pt.y - curs[k].y;
    // The tray position is step zero of the path, so the recorded track
    // always starts where the piece actually was.
    trajs[k] = [[curs[k].x, curs[k].y, 0]];
    t0 = Date.now();
    boost = 1;
    cv.style.cursor = "grabbing";
    if (e.cancelable) { e.preventDefault(); }
  }

  function drag(e) {
    if (!dragging) { return; }
    var pt = localPoint(e);
    setPiece(active, pt.x - grabDX, pt.y - grabDY);
    boost = 1;
    // A person who has just dragged a third piece needs to be told now, not
    // when they press the button: the mistake was made with the hand.
    var NEED = parseInt(host.dataset.need, 10) || 2;
    var have = placedCount();
    if (hint) {
      if (have > NEED) {
        hint.textContent = "只需要完成 " + NEED + " 块——把多拖的那 "
                         + (have - NEED) + " 块拖回原处即可";
        hint.style.color = "#d98a14";
      } else if (hint.style.color === "rgb(217, 138, 20)") {
        hint.textContent = "";
        hint.style.color = "";
      }
    }
    ripples.push({ x: curs[active].x + PW / 2, y: curs[active].y + PH / 2,
                   r: 6, life: 1 });
    if (ripples.length > 6) { ripples.shift(); }
    var now = Date.now() - t0;
    var tr = trajs[active];
    var last = tr[tr.length - 1];
    // ~60 samples a second is plenty for the analysis and keeps the field
    // small; the server wants the shape of the movement, not a video.
    if (!last || now - last[2] >= 12) {
      tr.push([curs[active].x, curs[active].y, now]);
    }
    if (e.cancelable) { e.preventDefault(); }
  }

  function drop() {
    if (!dragging) { return; }
    dragging = false;
    cv.style.cursor = "grab";
    var tr = trajs[active];
    tr.push([curs[active].x, curs[active].y, Date.now() - t0]);
  }

  cv.addEventListener("mousedown", grab, false);
  cv.addEventListener("touchstart", grab, { passive: false });
  document.addEventListener("mousemove", drag, false);
  document.addEventListener("mouseup", drop, false);
  document.addEventListener("touchmove", drag, { passive: false });
  document.addEventListener("touchend", drop, false);

  // Keyboard access: arrow keys nudge the piece nearest the gap the user is
  // working on, so the puzzle is not mouse-only. The path is recorded the
  // same way, which means a keyboard solve is judged on the same evidence.
  cv.tabIndex = 0;
  cv.addEventListener("keydown", function (e) {
    var step = e.shiftKey ? 8 : 2;
    var k = (active >= 0 && active < curs.length) ? active : 0;
    var nx = curs[k].x, ny = curs[k].y;
    if (e.key === "ArrowRight") { nx += step; }
    else if (e.key === "ArrowLeft") { nx -= step; }
    else if (e.key === "ArrowUp") { ny -= step; }
    else if (e.key === "ArrowDown") { ny += step; }
    else { return; }
    if (!t0) { t0 = Date.now(); trajs[k] = []; }
    setPiece(k, nx, ny);
    trajs[k].push([curs[k].x, curs[k].y, Date.now() - t0]);
    boost = 1;
    e.preventDefault();
  });

  form.addEventListener("submit", function (e) {
    // The page draws three pieces and asks for two, so "how many are out of
    // the tray" is itself an answer. Every piece is submitted -- including
    // the untouched one, at its tray position -- because the server decides
    // what was placed from the geometry, not from anything this script says.
    var NEED = parseInt(host.dataset.need, 10) || 2;
    var drops = [];
    var placed = 0;
    for (var sm = 0; sm < curs.length; sm++) {
      var moved = Math.abs(curs[sm].x - tray[sm].x) > TRAY_TOL
               || Math.abs(curs[sm].y - tray[sm].y) > TRAY_TOL;
      if (moved) {
        placed++;
        // A placed piece has to have been carried, not teleported.
        if (trajs[sm].length < 5) {
          e.preventDefault();
          if (hint) {
            hint.textContent = "请用拖动的方式把拼片移到位";
            hint.style.color = "#d98a14";
          }
          return false;
        }
      }
      drops.push({ x: curs[sm].x, y: curs[sm].y, track: trajs[sm] });
    }
    if (placed > NEED) {
      e.preventDefault();
      if (hint) {
        hint.textContent = "只需要完成 " + NEED + " 块——请把多拖的那 "
                         + (placed - NEED) + " 块拖回原处（它原来的位置有浅色轮廓）";
        hint.style.color = "#d98a14";
      }
      return false;
    }
    if (placed < NEED) {
      e.preventDefault();
      if (hint) {
        hint.textContent = "还需要再拖 " + (NEED - placed) + " 块到缺口（共 "
                         + NEED + " 块）";
        hint.style.color = "#d98a14";
      }
      return false;
    }
    if (fDrops) { fDrops.value = JSON.stringify(drops); }
    // The answer is chosen, not computed here: this script forwards the
    // selected option and knows nothing about which one is right.
    var picked = document.querySelector('input[name="q_answer"]:checked');
    if (!picked) {
      e.preventDefault();
      if (hint) {
        hint.textContent = "请先回答上面的问题";
        hint.style.color = "#d98a14";
      }
      return false;
    }
    var qa = document.getElementById("qa");
    if (qa) { qa.value = picked.value; }
    go.disabled = true;
  }, false);

  /* ---------------- images ----------------
   *
   * The requests went out at the very top of this script; all that is left is
   * to say what to draw when each one lands. Nothing here is a barrier: there
   * is deliberately no "how many are still outstanding" counter, because with
   * one, a single callback that never fired left the whole page blank -- no
   * picture, no error, nothing to look at. One picture failing costs that one
   * picture; the rest still draw and the scene still starts.
   */
  var loadedAny = 0;
  function maybeStart() {
    loadedAny++;
    if (raf === null) {
      for (var sj = 0; sj < curs.length; sj++) {
        setPiece(sj, tray[sj].x, tray[sj].y);
      }
      raf = requestAnimationFrame(frame);
    }
  }
  function settle(im, draw) {
    function done() {
      if (im && im.naturalWidth) { draw(im); }
      maybeStart();
    }
    if (!im) { maybeStart(); return; }
    // Already in hand -- preloaded above, or served from cache on a revisit:
    // draw now rather than wait for an event that has already fired.
    if (im.complete) { done(); return; }
    im.onload = done;
    im.onerror = function () { maybeStart(); };
  }
  settle(pre[PRE_BG], function (im) { bgCtx.drawImage(im, 0, 0, W, H); });
  settle(pre[PRE_OBJ], function (im) { objCtx.drawImage(im, 0, 0, W, H); });
  for (var li = 0; li < pieces.length; li++) {
    (function (slot) {
      settle(pre[PRE_PIECE + slot], function (im) {
        pieceCtx[slot].drawImage(im, 0, 0, PW, PH);
      });
    })(li);
  }
  // Eight seconds and not one picture: the network is the problem, not the
  // puzzle. Say so anyway -- silence is the one answer nobody can act on.
  setTimeout(function () {
    if (loadedAny === 0) { escapeToText("images did not load"); }
  }, 8000);
})();
</script>
<noscript>
  <div class="err" style="margin-top:16px">
    <?= $e($t('浏览器未启用 JavaScript，请改用文字验证码。',
              'JavaScript is disabled; please use the text challenge.')) ?>
    <a href="<?= $e($entryPath) ?>?fallback=text&amp;next=<?= $e(rawurlencode($next)) ?>">
      <?= $e($t('切换', 'Switch')) ?>
    </a>
  </div>
</noscript>
<?php endif; ?>
</body>
</html>
