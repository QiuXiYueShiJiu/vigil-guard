    <?php
    // Counted here, before anything uses the count. This was first written
    // after the label, so the sentence rendered as "拖动  块拼片" -- an empty
    // number rather than a wrong one, and only visible by looking at the
    // page. `$pieceList` below is built from the same array.
    $nPieces = count($slider['pieces'] ?? []);
    $zhCount = [2 => '两', 3 => '三', 4 => '四', 5 => '五',
                6 => '六', 7 => '七', 8 => '八', 9 => '九'][$nPieces]
               ?? (string)$nPieces;
    // How many have to be placed. The puzzle *draws* $nPieces and asks for
    // this many, which is the point: a solver that fills every piece it can
    // find has not read the instruction.
    $needPieces = min(2, $nPieces);
    $zhNeed = [2 => '两', 3 => '三', 4 => '四', 5 => '五'][$needPieces]
              ?? (string)$needPieces;
    ?>
    <label><?= $e($t(
        sprintf('图中共 %s 块拼片，只需完成其中任意 %s 块：把这 %s 块拖到'
                . '各自缺口，其余留在原处，并回答下面的问题',
                $zhCount, $zhNeed, $zhNeed),
        sprintf('There are %d pieces; any %d of them will do. Drag those %d '
                . 'into their gaps, leave the rest where they are, and answer '
                . 'the question below.', $nPieces, $needPieces, $needPieces))) ?></label>
    <?php
    // Where a picture comes from.
    //
    // By default it is carried inside this page as a `data:` URI. A picture
    // that has to be fetched is a picture that can fail to be fetched, and
    // when it did fail the server saw nothing at all: no request, no log
    // line, no way to tell a broken page from a slow one. Inlined, either the
    // picture is in the page or the page was not served.
    //
    // If the file cannot be read the URL is used instead, so this can never be
    // the reason a challenge is unsolvable.
    $inlinePics = !empty($cfg['inline_images']);
    $srcOf = static function (string $part) use ($inlinePics, $cfg, $slider, $stateDir): string {
        if ($inlinePics) {
            $uri = vigil_slider_data_uri($stateDir, (string)$slider['id'], $part);
            if ($uri !== '') {
                return $uri;
            }
        }
        return (string)$cfg['captcha'] . '?cid=' . $slider['id'] . '&part=' . $part;
    };

    // Each piece is described by where it belongs (y) and where to fetch it.
    // The x it must reach is deliberately absent: that is the answer.
    // The heading's number comes from `$nPieces`, which is this same array:
    // a number written into a translated string is a second source of truth
    // about the puzzle and drifts exactly like the endpoint's piece list did.
    $pieceList = [];
    foreach (($slider['pieces'] ?? []) as $slotNo => $pinfo) {
        $pieceList[] = [
            'y' => (int)$pinfo['y'] - (int)$slider['radius'],
            'u' => $srcOf('slider-piece' . ($slotNo + 1)),
        ];
    }
