  body { margin:0; min-height:100vh; display:flex; align-items:center;
         justify-content:center; padding:20px 14px; background:#eef3fa;
         font:15px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC",
              "Hiragino Sans GB","Microsoft YaHei",sans-serif; color:#1b2233; }
  .box { width:100%; max-width:420px; }
  h1 { margin:0 0 4px; font-size:17px; font-weight:650; }
