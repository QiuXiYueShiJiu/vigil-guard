<?php
/**
 * Slider puzzle at __DEMO_PATH__.
 *
 * Not a gate: nothing is protected, no session exists, nothing is
 * rate-limited. One file serves the page, the images and the verdict.
 *
 *   ?cid=<id>&part=slider-bg|slider-piece   images
 *   POST  cid, slider_x                                   verdict
 */
declare(strict_types=1);

require_once '__LIB_PATH__';

$stateDir = '__DEMO_STATE__';
$policy = ['captcha_ttl' => 3600, 'captcha_length' => 5, 'lock_max' => 999];

// The picture settings have to be passed too. They live in the gate's own
// config.php, which this page does not load -- and without them
// `vigil_slider_plate` falls through to generated art every single time, so
// the pool was never used here and the anime pictures never appeared.
$plateCfg = [
    'scene_kind'  => __DEMO_SCENE_KIND__,
    'image_dirs'  => __DEMO_IMAGE_DIRS__,
    'image_pool'  => $stateDir . '/image_pool.json',
    'image_cache' => __DEMO_IMAGE_CACHE__,
    'image_block' => __DEMO_IMAGE_BLOCK__,
];
@mkdir($stateDir . '/slider', 0755, true);
@mkdir($stateDir . '/captcha', 0755, true);

// The verdict arrives as a POST, so `cid` has to be read from both. Taking
// it only from the query string made every submission answer "expired"
// while the images, which do use GET, loaded perfectly.
$cid = (string)($_POST['cid'] ?? $_GET['cid'] ?? '');
$part = (string)($_GET['part'] ?? '');
$valid = preg_match('/^[0-9a-f]{32}$/', $cid) === 1;

// ---------------------------------------------------------------- assets --
if ($part !== '') {
    // No `slider-scene`: the unmarked copy is what let the page recover the
    // gap by differencing two images. Serving it here would reintroduce the
    // defect on the page people look at to judge the puzzle.
    //
    // The playground shows the first piece only: a demo is for seeing
    // what the challenge looks like, and duplicating the whole two-slider
    // widget here would be a second implementation to keep in step for no
    // security gain.
    // Resolved by the shared helper, not by a second hand-written list: this
    // page and the gate's own endpoint had drifted, and a name the generator
    // can write must be resolvable by every reader of it.
    $file = $valid ? vigil_slider_asset($stateDir, $cid, $part) : null;
    if ($file === null) {
        http_response_code(404);
        exit;
    }
    header('Content-Type: image/png');
    header('Cache-Control: private, max-age=300');
    readfile($file);
    exit;
}

// --------------------------------------------------------------- verdict --
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    header('Content-Type: application/json; charset=utf-8');
    // Parenthesised on purpose: without the brackets `.` binds tighter than
    // `?:`, so this used to parse as a concatenation used as the condition
    // and yield a bare filename with no directory in it.
    $meta = $valid ? ($stateDir . '/captcha/' . $cid . '.json') : '';
    $data = $meta !== '' && is_file($meta)
        ? json_decode((string)@file_get_contents($meta), true) : null;
    if (!is_array($data)) {
        echo json_encode(['ok' => false, 'error' => '已过期'],
                         JSON_UNESCAPED_UNICODE);
        exit;
    }
    $answer = (int)($_POST['slider_x'] ?? -99999);
    $delta = abs($answer - (int)$data['x']);
    $tol = 16;
    // Both factors, same as the gate: the piece in the gap *and* the
    // passcode read off the picture. The demo should show the real thing --
    // a playground that passes on the easier half teaches the wrong lesson.
    $codeOK = true;
    if (array_key_exists('q_ans', $data)) {
        $want = (string)(int)$data['q_ans'];
        $got  = trim((string)($_POST['q_answer'] ?? ''));
        $codeOK = ($got !== '' && hash_equals($want, $got));
    }
    // Pass or fail, and nothing else. Returning the distance turns the
    // endpoint into an oracle: an attacker binary-searches the offset in a
    // handful of requests and never has to look at the picture. It is also
    // deliberately a single boolean: saying which factor failed would let a
    // script search the two independently.
    echo json_encode(['ok' => true, 'pass' => ($delta <= $tol) && $codeOK],
                     JSON_UNESCAPED_UNICODE);
    exit;
}

// ------------------------------------------------------------------ page --
$slider = vigil_new_slider($stateDir, $policy, $plateCfg);
if (empty($slider['ok'])) {
    http_response_code(500);
    echo '<!DOCTYPE html><meta charset="utf-8"><p>无法生成拼图（需要 PHP GD）</p>';
    exit;
}
$scramble = vigil_slider_scramble((int)$slider['width'], (int)$slider['height'],
                                  (string)($slider['kind'] ?? 'art'));
$e = static fn(string $s): string => htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
$self = '__DEMO_PATH__';
?>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
