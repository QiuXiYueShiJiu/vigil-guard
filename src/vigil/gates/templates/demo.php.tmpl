  .track .handle { position:absolute; top:0; left:0; width:44px; height:42px;
                   display:flex; align-items:center; justify-content:center;
                   background:#fff; border:1px solid #cdd7e5; border-radius:9px;
                   cursor:grab; font-size:16px; color:#5a6c85; }
  .track .label { position:absolute; inset:0; display:flex; align-items:center;
                  justify-content:center; font-size:12.5px; color:#9aa6b8;
