<?php
/**
 * Vigil gate library — shared by every gate type.
 *
 * All of the security-relevant logic lives here rather than in the page
 * templates, so there is exactly one implementation of "compare a CAPTCHA",
 * "count a failure" and "issue a session" to audit.
 *
 * Threat model: the attacker can fetch unlimited challenges, submit
 * unlimited answers, replay anything they captured, and run from many
 * addresses. Defences, in the order they apply:
 *
 *   1. challenge is bound to the client (address + user agent) — a cid
 *      harvested elsewhere is useless, which kills challenge-farming;
 *   2. a minimum solve time — no human types five characters in under a
 *      second, so instant answers are rejected before comparison;
 *   3. a honeypot field — hidden from people, irresistible to scrapers;
 *   4. one-time consumption, unlinked *before* comparison — a captured
 *      answer cannot be replayed even if the request is retried;
 *   5. constant-time comparison via hash_equals;
 *   6. per-address failure counting with *exponential* backoff, so a
 *      sustained guessing run gets progressively more expensive;
 *   7. per-address challenge-issue limiting, so the challenge store cannot
 *      be exhausted as a denial-of-service;
 *   8. bounded pruning of both challenges and sessions.
 *
 * @package vigil
 */

declare(strict_types=1);

// --------------------------------------------------------------------------
// Configuration
// --------------------------------------------------------------------------

/**
 * Parse the shared policy file.
 *
 * Only integer keys are honoured, so a malformed or hostile policy file can
 * never inject strings into the logic.
 */
function vigil_policy(string $path): array
{
    $defaults = [
        'session_ttl' => 1800, 'nav_ttl' => 120, 'captcha_ttl' => 180,
        'abs_ttl' => 43200, 'bind_ua' => 1, 'bind_ip' => 0,
        'lock_max' => 8, 'lock_secs' => 900, 'max_sessions' => 100,
        // First lockout length, and the multiplier for each repeat. The old
        // shape had no separate first value: lock_secs * backoff^(strikes-1)
        // with backoff defaulting to 1, so the documented "exponential
        // backoff" was in fact a flat 15 minutes every time -- a comment that
        // lied about the code. Now the first lock is short and it really does
        // grow, capped by lock_secs.
        'lock_first_secs' => 120,
        // A wrong *password* is not a failed challenge and must not spend the
        // same budget: a person mistyping a password was being locked out of
        // the puzzle for 15 minutes by the fifth keystroke-level mistake.
        // Guessing is already bounded by the puzzle (one solved challenge per
        // guess), so this budget is deliberately far more generous.
        'cred_max' => 20, 'cred_lock_secs' => 300,
        // Security tuning (all optional; safe defaults if absent).
        'captcha_min_seconds' => 1, 'captcha_max_tries' => 6,
        'captcha_per_minute' => 12, 'lock_backoff' => 1,
        'captcha_length' => 5,
    ];
    $out = $defaults;
    if (!is_readable($path)) {
        return $out;
    }
    foreach (file($path, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
        if (!preg_match('/^\s*([a-z_]+)\s*=\s*(\d+)/', $line, $m)) {
            continue;
        }
        if (array_key_exists($m[1], $out)) {
            $out[$m[1]] = (int)$m[2];
        }
    }
    // Clamp: a typo must not be able to disable a protection entirely.
    $out['captcha_length'] = max(4, min(8, $out['captcha_length']));
    $out['captcha_min_seconds'] = max(0, min(30, $out['captcha_min_seconds']));
    $out['lock_max'] = max(2, $out['lock_max']);
    $out['lock_first_secs'] = max(5, min(3600, $out['lock_first_secs']));
    $out['lock_backoff'] = max(1, min(8, $out['lock_backoff']));
    $out['cred_max'] = max(3, $out['cred_max']);
    $out['cred_lock_secs'] = max(5, min(3600, $out['cred_lock_secs']));
    $out['session_ttl'] = max(60, $out['session_ttl']);
    return $out;
}

/** Create the state directories with private permissions. */
function vigil_state_dirs(string $stateDir): void
{
    foreach (['', 'sessions', 'captcha', 'fails', 'logs'] as $sub) {
        $d = rtrim($stateDir, '/') . ($sub === '' ? '' : '/' . $sub);
        if (!is_dir($d)) {
            @mkdir($d, 0700, true);
        }
        @chmod($d, 0700);
    }
}

// --------------------------------------------------------------------------
// Client identity
// --------------------------------------------------------------------------

/** Best-effort real client address (honours the trusted proxy setup). */
function vigil_client_ip(): string
{
    $ip = (string)($_SERVER['REMOTE_ADDR'] ?? '');
    return $ip !== '' ? $ip : '0.0.0.0';
}

/**
 * Bind a challenge to the client.
 *
 * Only address and user agent are mixed in — deliberately not anything the
 * client controls per-request, or a proxy that rewrites headers would break
 * legitimate logins.
 */
function vigil_client_binding(): string
{
    return hash('sha256', vigil_client_ip() . '|'
                         . (string)($_SERVER['HTTP_USER_AGENT'] ?? ''));
}

// --------------------------------------------------------------------------
// CAPTCHA
// --------------------------------------------------------------------------

/** Alphabet without look-alike glyphs, so a human is never failed by font. */
function vigil_alphabet(): string
{
    return 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
}

/**
 * Create a challenge and return its id plus the answer (for rendering).
 *
 * Difficulty rises with recent failures from the same address: longer code
 * and heavier distortion. A legitimate user who mistyped once barely
 * notices; a scripted attacker loses throughput immediately.
 */
function vigil_new_captcha(string $stateDir, array $policy): array
{
    $fails = vigil_fail_count($stateDir);
    $length = (int)$policy['captcha_length'];
    if ($fails >= 2) {
        $length = min(8, $length + 1);
    }
    if ($fails >= 5) {
        $length = min(8, $length + 1);
    }

    $alphabet = vigil_alphabet();
    $code = '';
    for ($i = 0; $i < $length; $i++) {
        $code .= $alphabet[random_int(0, strlen($alphabet) - 1)];
    }

    $id = bin2hex(random_bytes(16));
    $payload = json_encode([
        'code'   => $code,
        'exp'    => time() + (int)$policy['captcha_ttl'],
        'born'   => time(),
        'bind'   => vigil_client_binding(),
        'weight' => $fails,
    ], JSON_UNESCAPED_SLASHES);
    $file = rtrim($stateDir, '/') . '/captcha/' . $id . '.json';
    file_put_contents($file, (string)$payload, LOCK_EX);
    @chmod($file, 0600);
    // `weight` is returned as well as stored: the page draws the picture
    // itself now, and a caller that had to re-read the state file to find the
    // fail count would silently draw every challenge at weight 0 -- i.e. the
    // repeat offender would get the *easiest* picture, the exact opposite of
    // the intent.
    return ['id' => $id, 'code' => $code, 'length' => $length,
            'weight' => $fails];
}

/**
 * Validate and consume a challenge.
 *
 * Returns ['ok' => bool, 'reason' => string]. The reason is for the audit
 * log only — never shown to the client, because telling an attacker *why*
 * they failed is free reconnaissance.
 */
function vigil_check_captcha(string $stateDir, array $policy,
                             string $cid, string $answer,
                             bool $honeypotTripped): array
{
    // Cheap rejections first, so a flood of obvious junk costs no I/O.
    if ($honeypotTripped) {
        return ['ok' => false, 'reason' => 'HONEYPOT'];
    }
    if (!preg_match('/^[0-9a-f]{32}$/', $cid)) {
        return ['ok' => false, 'reason' => 'BAD_ID'];
    }
    $file = rtrim($stateDir, '/') . '/captcha/' . $cid . '.json';
    if (!is_file($file)) {
        return ['ok' => false, 'reason' => 'MISSING'];
    }

    // Consume before comparing: a retry can never succeed, so an attacker
    // cannot re-use an answer even if they capture the request.
    $raw = (string)@file_get_contents($file);
    @unlink($file);

    $data = json_decode($raw, true);
    if (!is_array($data)) {
        return ['ok' => false, 'reason' => 'CORRUPT'];
    }
    if ((int)($data['exp'] ?? 0) < time()) {
        return ['ok' => false, 'reason' => 'EXPIRED'];
    }
    if (!hash_equals((string)($data['bind'] ?? ''), vigil_client_binding())) {
        // The challenge was fetched by someone else. This is the signature
        // of a relay/farming attempt rather than a mistyped character.
        return ['ok' => false, 'reason' => 'BINDING'];
    }
    $elapsed = time() - (int)($data['born'] ?? 0);
    if ($elapsed < (int)$policy['captcha_min_seconds']) {
        return ['ok' => false, 'reason' => 'TOO_FAST'];
    }
    $expected = strtoupper(trim((string)($data['code'] ?? '')));
    $got = strtoupper(trim($answer));
    if ($expected === '' || !hash_equals($expected, $got)) {
        return ['ok' => false, 'reason' => 'WRONG'];
    }
    return ['ok' => true, 'reason' => 'OK'];
}

// --------------------------------------------------------------------------
// Failure accounting / lockout
// --------------------------------------------------------------------------

function vigil_fail_file(string $stateDir): string
{
    return rtrim($stateDir, '/') . '/fails/'
           . hash('sha256', vigil_client_ip()) . '.json';
}

function vigil_fail_state(string $stateDir): array
{
    $f = vigil_fail_file($stateDir);
    $d = is_file($f) ? json_decode((string)@file_get_contents($f), true) : null;
    if (!is_array($d)) {
        $d = ['count' => 0, 'until' => 0, 'strikes' => 0, 'issued' => 0,
              'issued_at' => 0, 'cred' => 0];
    }
    foreach (['count', 'until', 'strikes', 'issued', 'issued_at',
              'cred'] as $k) {
        $d[$k] = (int)($d[$k] ?? 0);
    }
    return $d;
}

function vigil_fail_count(string $stateDir): int
{
    return (int)(vigil_fail_state($stateDir)['strikes'] ?? 0);
}

/**
 * Record a failure and lock the address out with exponential backoff.
 *
 * Two budgets, deliberately separate:
 *
 *   CHALLENGE  the puzzle was not solved (bad drag, wrong answer, no track).
 *              This is what an automated solver produces, so it keeps the
 *              tighter budget.
 *   BAD_CRED   the puzzle *was* solved and the password was wrong. A person
 *              mistyping a password is the common case here, and it used to
 *              share the challenge budget -- five fat-fingered logins locked
 *              somebody out of the puzzle for fifteen minutes. Guessing is
 *              already bounded by the puzzle itself (a solved challenge is
 *              required per guess), so this budget is much more generous and
 *              its lock is short.
 *
 * The duration grows: first lock `lock_first_secs`, then multiplied by
 * `lock_backoff` per repeat lockout, capped at `lock_secs`. The old formula
 * was `lock_secs * backoff^(strikes-1)` with backoff defaulting to 1, so it
 * was flat in practice however the comment described it.
 */
function vigil_fail_bump(string $stateDir, array $policy,
                         string $reason = 'CHALLENGE'): void
{
    $d = vigil_fail_state($stateDir);
    $now = time();
    if ($reason === 'BAD_CRED') {
        $d['cred']++;
        if ($d['cred'] >= (int)$policy['cred_max']) {
            $d['until'] = $now + (int)$policy['cred_lock_secs'];
            $d['cred'] = 0;
        }
    } else {
        $d['count']++;
        if ($d['count'] >= (int)$policy['lock_max']) {
            $d['strikes']++;
            $first = (int)($policy['lock_first_secs'] ?? 120);
            $backoff = max(1, (int)$policy['lock_backoff']);
            $cap = max($first, (int)$policy['lock_secs']);
            $grow = $first * ($backoff ** min(6, $d['strikes'] - 1));
            $d['until'] = $now + (int)min($cap, $grow);
            $d['count'] = 0;
        }
    }
    $f = vigil_fail_file($stateDir);
    file_put_contents($f, json_encode($d), LOCK_EX);
    @chmod($f, 0600);
}

/**
 * Delete lockout records that can no longer matter.
 *
 * Without this the directory is append-only history: every address that ever
 * failed once keeps a file forever, and on this host that had already grown
 * to twenty-odd records with nothing to remove them. A record is worth
 * keeping only while it still describes a live hold or a counted failure, so
 * the sweeper removes:
 *
 *   · holds that expired more than `grace` ago (default one day),
 *   · records with nothing counted and no hold (a bare `issued` counter),
 *   · anything untouched for `max_age` days (default 7),
 *   · files that are not the current JSON shape at all (an older format).
 *
 * Throttled by a marker file, because it is called from every page render and
 * pruning must never become the expensive part of serving a login page.
 */
function vigil_fail_sweep(string $stateDir, int $grace = 86400,
                          int $max_age = 604800, int $every = 3600): int
{
    $dir = rtrim($stateDir, '/') . '/fails';
    if (!is_dir($dir)) {
        return 0;
    }
    $marker = $dir . '/.swept';
    $last = is_file($marker) ? (int)@filemtime($marker) : 0;
    $now = time();
    if ($last && $now - $last < $every) {
        return 0;
    }
    @touch($marker);
    $removed = 0;
    foreach (glob($dir . '/*') ?: [] as $f) {
        $base = basename($f);
        if ($base === '.swept' || !is_file($f)) {
            continue;
        }
        $age = $now - (int)@filemtime($f);
        $kill = false;
        if (substr($base, -5) !== '.json') {
            // Not the current shape: a file from an older format. It is not
            // read by anything any more.
            $kill = $age > $grace;
        } else {
            $d = json_decode((string)@file_get_contents($f), true);
            if (!is_array($d)) {
                $kill = $age > $grace;
            } else {
                $until = (int)($d['until'] ?? 0);
                $count = (int)($d['count'] ?? 0);
                $strikes = (int)($d['strikes'] ?? 0);
                $cred = (int)($d['cred'] ?? 0);
                if ($until > 0 && $until < $now - $grace) {
                    $kill = true;                       // long-expired hold
                } elseif ($until === 0 && $count === 0 && $strikes === 0
                          && $cred === 0) {
                    $kill = true;                       // nothing to remember
                } elseif ($age > $max_age) {
                    $kill = true;                       // simply too old
                }
            }
        }
        if ($kill) {
            @unlink($f);
            $removed++;
        }
    }
    return $removed;
}

/** Remaining lock seconds, or 0. */
function vigil_locked_for(string $stateDir): int
{
    $until = (int)vigil_fail_state($stateDir)['until'];
    return max(0, $until - time());
}

function vigil_fail_clear(string $stateDir): void
{
    @unlink(vigil_fail_file($stateDir));
}

/**
 * Challenge-issue rate limit.
 *
 * Without this, an attacker can mint challenges in a loop and fill the
 * state directory — a disk-exhaustion denial of service that also destroys
 * the ability of real users to log in.
 */
function vigil_can_issue(string $stateDir, array $policy): bool
{
    $d = vigil_fail_state($stateDir);
    $now = time();
    if ($now - $d['issued_at'] > 60) {
        $d['issued_at'] = $now;
        $d['issued'] = 0;
    }
    if ($d['issued'] >= (int)$policy['captcha_per_minute']) {
        return false;
    }
    $d['issued']++;
    $f = vigil_fail_file($stateDir);
    file_put_contents($f, json_encode($d), LOCK_EX);
    @chmod($f, 0600);
    return true;
}


// --------------------------------------------------------------------------
// Slider puzzle CAPTCHA
// --------------------------------------------------------------------------
//
// Why a puzzle rather than more distorted text: text CAPTCHAs are beaten by
// OCR, and the arms race is unwinnable -- modern models read warped text
// better than most people. A jigsaw alignment task is a different problem:
// the solver has to *locate a matching pattern* and then reproduce a human
// motion, which is far more expensive to automate and, unlike warped text,
// does not get harder for a person with poor eyesight.
//
// Defences layered on top of the alignment itself:
//   · the correct offset is NEVER sent to the client -- only the images are;
//   · the piece is cut from a randomly generated background, so the puzzle
//     cannot be pre-solved or looked up;
//   · tolerance shrinks as failures accumulate, turning a lucky guess into
//     an increasingly unlikely one;
//   · the drag trajectory must look human (sampled, varied speed, forward
//     only), which rejects "set the value and submit" scripts even when they
//     guess the offset correctly;
//   · the drag must take a plausible amount of time.

/** Geometric parameters of the puzzle. */
function vigil_slider_geometry(string $stateDir, array $policy): array
{
    $size = 46;
    $radius = 9;
    return [
        'piece'  => $size,
        'radius' => $radius,
        // 340x200 was legible but soft on a modern display: the canvas is
        // scaled up by CSS to fill a ~400px card, so every pixel was being
        // stretched before it reached the eye. 480x280 keeps the same 12:7
        // framing and needs no crop change, and the piece and gap scale with
        // it. Cost is roughly double the draw time -- about 0.2s on the
        // slowest host measured -- which a login page can afford once.
        'width'  => 480,
        'height' => 280,
        // Tolerance is deliberately generous. It was 10px, which is under 4%
        // of the track: technically defensible and miserable to actually
        // use, because a mouse slip of a few pixels failed the challenge.
        // 16px still leaves an effectively impossible chance of a blind
        // guess (the track is ~285px, so roughly 1 in 9), while a person
        // aiming at a visible target lands it comfortably.
        'tolerance' => max(14, 16 - vigil_fail_count_direct($stateDir)),
        // How far the piece must travel before the picture is considered
        // "close". Used only for the visual warm/cold indication.
        'approach'  => 90,
    ];
}

/**
 * Scene presets -- Q-style anime, cel-shaded.
 *
 * Five flat-colour, thick-outline cartoon landscapes. Each has one light
 * source, one palette and its own mood, and all five use the same visual
 * grammar: two or three flat tones per object, a single dark outline, no
 * gradients except the sky, and chunky rounded silhouettes.
 *
 * Beyond looking right, the style is doing real work for the puzzle. Flat
 * shapes and heavy outlines are high-contrast structure spread over the whole
 * frame, so a band shifted sideways snaps visibly and a correctly seated
 * piece is obvious -- an earlier photoreal gradient-and-ribbons background
 * looked busy but had almost no alignment signal, which is why solved and
 * scrambled were hard to tell apart.
 *
 * `ink` outlines the gap; `glow` and `accent` are handed to the browser to
 * tint the live animation drawn over this still image.
 */
